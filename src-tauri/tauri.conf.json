{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Console Launcher",
  "version": "0.1.8",
  "identifier": "app.launcher.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Console Launcher",
        "width": 1280,
        "height": 720,
        "decorations": false,
        "fullscreen": true,
        "visible": false,
        "resizable": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,CalculateNativeWinOcclusion --disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "DesenvSouza",
    "license": "GPL-3.0-only",
    "licenseFile": "installer-notice.txt",
    "copyright": "© 2026 DesenvSouza",
    "shortDescription": "Launcher de jogos para TV, controlado por controle",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": {
      "nsis": { "installerHooks": "installer-hooks.nsh", "installerIcon": "icons/icon.ico" }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE0NUI0RTc3QkE4REVDREYKUldUZjdJMjZkMDVicEVCbURFUFFEOFhsWTZwalk1REsrb2l5cDR0NS96VjBvZThvaHRTNlkybXAK",
      "endpoints": ["https://github.com/DesenvSouza/ConsoleLancher/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": { "installMode": "passive" }
    }
  }
}
